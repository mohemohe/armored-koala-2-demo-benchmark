{
  "name": "armored-koala-2-demo",
  "version": "1.0.0",
  "private": true,
  "description": "ARMORED KOALA 2 (AK2) DEMO - TPS high-speed mech action shooter built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"tests/{audit-enemies-state,audit-combat-extra,audit-ui-browser,nav-stuck-real,playthrough,stage-blueprint,stage-validator,turret-kill}.test.ts\"",
    "stage:report": "tsx tools/stage-report.ts",
    "e2e": "tsx tools/e2e.ts",
    "playthrough": "tsx tools/playthrough.ts",
    "perf": "tsx tools/perf-bench.ts"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
